TELEGRAM_BOT_TOKEN=
FOUNDER_CHAT_ID=
GEMINI_API_KEY=

MOCK_MODE=true

# Runtime storage: mock and live traffic use separate
# directories by default (data/mock and data/live).
# DATA_DIR overrides the mode-specific default.
# DATA_DIR=
# MOCK_DATA_DIR=data/mock
# LIVE_DATA_DIR=data/live

BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=18
UNCOVERED_END_HOUR=21

AGENT_NAMES=Agent,Sales,Admin
DATA_DIR=
PROPERTIES_FILE=data/properties.json

# Process-local anti-flood limits (0 disables the limit).
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=50

# Live Gemini drafting settings.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30

# Offline WhatsApp audit parsing.
AUDIT_DATE_ORDER=day_first
AUDIT_TIMEZONE=Africa/Nairobi